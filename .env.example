# Скопируй этот файл в .env и вставь свой ключ (получить: https://aistudio.google.com/apikey)
GEMINI_API_KEY=вставь_ключ_сюда

# Порт шлюза (если занят — проверь свободные: netstat -ano | findstr :8081)
GATEWAY_PORT=8081

# URL настоящекого Gemini API (туда шлюз отправляет запросы)
GEMINI_UPSTREAM=https://generativelanguage.googleapis.com/v1beta

# Модель для LLM-сжатия
COMPRESSOR_MODEL=gemini-3.1-flash-lite

# ============================================================================
# OAuth Authentication (опционально)
# ============================================================================

# Google OAuth (получить: https://console.cloud.google.com/apis/credentials)
# 1. Создай OAuth 2.0 Client ID
# 2. Добавь redirect URI: http://localhost:8082/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth (получить: https://github.com/settings/developers)
# 1. Создай New OAuth App
# 2. Authorization callback URL: http://localhost:8082/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Base URL для OAuth redirects (в production измени на свой домен)
BASE_URL=http://localhost:8082

# Секрет для сессий (сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))")
SESSION_SECRET=your_random_session_secret_here

